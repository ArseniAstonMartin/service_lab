# Database (Supabase Postgres via Prisma)
# Pooled connection (Supavisor, transaction mode) — used at runtime.
# Get this exact string from: Supabase Dashboard -> Project Settings ->
# Database -> Connection Pooling -> Transaction. Must keep ?pgbouncer=true.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection — used only for migrations (prisma migrate).
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# Vercel Blob
BLOB_READ_WRITE_TOKEN="[BLOB_TOKEN]"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend
RESEND_API_KEY="re_..."
ADMIN_NOTIFICATION_EMAIL="admin@example.com"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
