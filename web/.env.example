# Database (Supabase Postgres via Prisma), project vsawotguarbbamwcvkew,
# region us-west-1 — exact format from Supabase's own Prisma setup guide.

# Transaction-mode pooler (IPv4, pgbouncer) — used at runtime.
DATABASE_URL="postgresql://postgres.vsawotguarbbamwcvkew:[PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler — used for migrations (prisma migrate).
DIRECT_URL="postgresql://postgres.vsawotguarbbamwcvkew:[PASSWORD]@aws-0-us-west-1.pooler.supabase.com:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://vsawotguarbbamwcvkew.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[PUBLISHABLE_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# Vercel Blob
BLOB_READ_WRITE_TOKEN="[BLOB_TOKEN]"

# Stripe — use sk_live_ / the live webhook secret in Vercel Production
# (TASK-046). Local/dev can stay on sk_test_.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend
RESEND_API_KEY="re_..."
ADMIN_NOTIFICATION_EMAIL="admin@example.com"
# Optional — defaults to the verified best-auto-repair.com sending domain
# (TASK-046) when unset. Override only if your own Resend account doesn't
# have that domain verified (e.g. local dev against a different account).
RESEND_FROM_EMAIL="ECU Service Lab <orders@best-auto-repair.com>"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Sentry (ADD-SENTRY) — org "hawaii-service-lab", project
# "ecu-service-lab-web". The DSN is not a secret (it's shipped in the
# client bundle either way), so the real value is filled in below;
# leaving both unset disables the SDK entirely (see sentry.*.config.ts).
NEXT_PUBLIC_SENTRY_DSN="https://a6a945238e6a957b934af672eddec6df@o4512147995164672.ingest.us.sentry.io/4512165695127552"
SENTRY_DSN="https://a6a945238e6a957b934af672eddec6df@o4512147995164672.ingest.us.sentry.io/4512165695127552"
# Used only by the build-time source-map upload (next.config.mjs's
# withSentryConfig) — never set SENTRY_AUTH_TOKEN here or commit a real
# value; create one at https://hawaii-service-lab.sentry.io (Settings →
# Auth Tokens, scopes: project:releases + org:read) and set it in Vercel
# instead. Without it the build still succeeds, just without source maps.
SENTRY_ORG="hawaii-service-lab"
SENTRY_PROJECT="ecu-service-lab-web"
SENTRY_AUTH_TOKEN=""
