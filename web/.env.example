# Database (Supabase Postgres via Prisma), project vsawotguarbbamwcvkew,
# region us-west-1 — exact format from Supabase's own Prisma setup guide.

# Transaction-mode pooler (IPv4, pgbouncer) — used at runtime.
DATABASE_URL="postgresql://postgres.vsawotguarbbamwcvkew:[PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler — used for migrations (prisma migrate).
DIRECT_URL="postgresql://postgres.vsawotguarbbamwcvkew:[PASSWORD]@aws-0-us-west-1.pooler.supabase.com:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://vsawotguarbbamwcvkew.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[PUBLISHABLE_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# Vercel Blob
BLOB_READ_WRITE_TOKEN="[BLOB_TOKEN]"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend
RESEND_API_KEY="re_..."
ADMIN_NOTIFICATION_EMAIL="admin@example.com"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
