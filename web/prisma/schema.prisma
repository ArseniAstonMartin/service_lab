// Prisma schema for ECU Service Lab.
// Models are added task by task (see TASK-003/004/005 in the Project's
// tasks.json). Covers reference data (TASK-003): Vehicle, ModuleCategory,
// PriceTier, Service, CompatibilityEntry, CompatibilityService; and orders
// (TASK-004): Order, OrderPhoto, OrderAnswer, OrderStatusHistory.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Transaction-mode pooler (Supabase Supavisor, IPv4, pgbouncer) — used
  // at runtime by the app. Must include ?pgbouncer=true.
  url       = env("DATABASE_URL")
  // Session-mode pooler — used only for `prisma migrate` / `prisma db
  // push`. (Supabase recommends the session pooler over the bare direct
  // db.<ref>.supabase.co host, which is IPv6-only on the free tier.)
  directUrl = env("DIRECT_URL")
}

// --- Reference data (TASK-003) -------------------------------------------

model Vehicle {
  id    BigInt @id @default(autoincrement())
  make  String @db.VarChar(50)
  model String @db.VarChar(50)
  year  Int    @db.SmallInt

  compatibilityEntries CompatibilityEntry[]
  orders               Order[]

  @@unique([make, model, year])
  @@map("vehicles")
}

model ModuleCategory {
  id   BigInt @id @default(autoincrement())
  name String @db.VarChar(50)

  compatibilityEntries CompatibilityEntry[]
  services             Service[]
  orders               Order[]

  @@map("module_categories")
}

enum EntrySource {
  import
  admin_confirmed

  @@map("entry_source")
}

model CompatibilityEntry {
  id           BigInt      @id @default(autoincrement())
  vehicleId    BigInt      @map("vehicle_id")
  categoryId   BigInt      @map("category_id")
  partNumber   String      @map("part_number") @db.VarChar(100)
  photoHintUrl String?     @map("photo_hint_url") @db.VarChar(500)
  source       EntrySource
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle       Vehicle                @relation(fields: [vehicleId], references: [id])
  category      ModuleCategory         @relation(fields: [categoryId], references: [id])
  services      CompatibilityService[]
  matchedOrders Order[]

  // Exact-match lookup: one entry per (vehicle, category, part number).
  @@unique([vehicleId, categoryId, partNumber])
  // part_number is also looked up on its own during CSV import validation.
  @@index([partNumber])
  @@map("compatibility_entries")
}

model PriceTier {
  tierCode    String @id @map("tier_code") @db.VarChar(10)
  amountCents Int    @map("amount_cents")

  services Service[]

  @@map("price_tiers")
}

model Service {
  id              BigInt @id @default(autoincrement())
  categoryId      BigInt @map("category_id")
  name            String @db.VarChar(100)
  tierCode        String @map("price_tier") @db.VarChar(10)
  questionSetCode String @map("question_set_code") @db.VarChar(30)

  category           ModuleCategory          @relation(fields: [categoryId], references: [id])
  priceTier          PriceTier               @relation(fields: [tierCode], references: [tierCode])
  compatibilityLinks CompatibilityService[]
  orders             Order[]

  @@map("services")
}

// Junction table: which services are confirmed supported for a given
// compatibility entry (Make/Model/Year/Category/Part Number).
model CompatibilityService {
  entryId   BigInt @map("entry_id")
  serviceId BigInt @map("service_id")

  entry   CompatibilityEntry @relation(fields: [entryId], references: [id])
  service Service            @relation(fields: [serviceId], references: [id])

  @@id([entryId, serviceId])
  @@map("compatibility_services")
}

// --- Orders (TASK-004) ----------------------------------------------------

enum OrderStatus {
  pending_review
  awaiting_payment
  payment_received
  block_received
  in_progress
  ready_shipped_back
  completed

  @@map("order_status")
}

enum PhotoType {
  sticker
  donor
  original

  @@map("photo_type")
}

model Order {
  id                     BigInt      @id @default(autoincrement())
  trackingToken          String      @unique @map("tracking_token") @db.VarChar(64)
  status                 OrderStatus @default(pending_review)
  vehicleId              BigInt      @map("vehicle_id")
  categoryId             BigInt      @map("category_id")
  partNumberEntered      String      @map("part_number_entered") @db.VarChar(100)
  matchedEntryId         BigInt?     @map("matched_entry_id")
  serviceId              BigInt?     @map("service_id")
  description            String      @db.Text
  customerName           String      @map("customer_name") @db.VarChar(150)
  customerEmail          String      @map("customer_email") @db.VarChar(255)
  customerPhone          String      @map("customer_phone") @db.VarChar(50)
  returnAddressStreet    String      @map("return_address_street") @db.VarChar(255)
  returnAddressCity      String      @map("return_address_city") @db.VarChar(100)
  returnAddressState     String      @map("return_address_state") @db.VarChar(2)
  returnAddressZip       String      @map("return_address_zip") @db.VarChar(10)
  // Price snapshot -- null until the order is matched (auto or admin-confirmed).
  servicePriceCents      Int?        @map("service_price_cents")
  returnShippingFeeCents Int?        @map("return_shipping_fee_cents")
  totalAmountCents       Int?        @map("total_amount_cents")
  stripePaymentLinkId    String?     @map("stripe_payment_link_id") @db.VarChar(100)
  paymentLinkUrl         String?     @map("payment_link_url") @db.VarChar(500)
  stripePaymentStatus    String?     @map("stripe_payment_status") @db.VarChar(30)
  shippingLabelUrl       String?     @map("shipping_label_url") @db.VarChar(500)
  returnTrackingNo       String?     @map("return_tracking_no") @db.VarChar(100)
  // Generated once per wizard session on the client; a repeat submit with
  // the same key returns the existing order instead of creating a duplicate.
  idempotencyKey         String      @unique @map("idempotency_key") @db.VarChar(100)
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle       Vehicle              @relation(fields: [vehicleId], references: [id])
  category      ModuleCategory       @relation(fields: [categoryId], references: [id])
  matchedEntry  CompatibilityEntry?  @relation(fields: [matchedEntryId], references: [id])
  service       Service?             @relation(fields: [serviceId], references: [id])
  photos        OrderPhoto[]
  answers       OrderAnswer[]
  statusHistory OrderStatusHistory[]

  @@index([status])
  @@index([customerEmail])
  @@index([partNumberEntered])
  @@index([createdAt])
  @@map("orders")
}

model OrderPhoto {
  id         BigInt    @id @default(autoincrement())
  orderId    BigInt    @map("order_id")
  photoType  PhotoType @map("photo_type")
  blobUrl    String    @map("blob_url") @db.VarChar(500)
  uploadedAt DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_photos")
}

model OrderAnswer {
  id           BigInt @id @default(autoincrement())
  orderId      BigInt @map("order_id")
  questionCode String @map("question_code") @db.VarChar(50)
  answerValue  String @map("answer_value") @db.Text

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_answers")
}

model OrderStatusHistory {
  id        BigInt      @id @default(autoincrement())
  orderId   BigInt      @map("order_id")
  status    OrderStatus
  changedAt DateTime    @default(now()) @map("changed_at") @db.Timestamptz(6)
  changedBy String      @map("changed_by") @db.VarChar(50)

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_status_history")
}
